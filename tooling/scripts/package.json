{
  "name": "@genex/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed": "bun --env-file ../../.env seed.ts",
    "db:backfill-user-slugs": "bun --env-file ../../.env backfill-user-slugs.ts",
    "db:seed-demo": "bun --env-file ../../.env seed-demo-data.ts"
  },
  "dependencies": {
    "@genex/auth": "workspace:*",
    "@genex/db": "workspace:*",
    "@genex/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  }
}
