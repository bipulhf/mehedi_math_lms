# For running the apps directly on the host (bun dev / bun run start), not
# Docker -- for `docker compose up`, copy .env.docker.example instead.

APP_NAME="Mehedi's Math Academy"
APP_URL="https://mehedismathacademy.com"
NODE_ENV="development"
LOG_LEVEL="info"

# --- Web (Vite, build-time -- see apps/web/Dockerfile) ------------------
# Baked into the browser bundle when the web image is built; changing
# these requires rebuilding the web image, not just restarting it.
VITE_API_BASE_URL="http://localhost:3001/api/v1"
# Only used inside apps/web's own Dockerfile build; docker-compose.yml
# always overrides this to http://api:3001/api/v1 for the in-network SSR
# call, regardless of what's set here. Left here for non-Docker builds.
VITE_SSR_API_BASE_URL="http://127.0.0.1:3001/api/v1"
# The one Firebase value the browser needs directly. `FIREBASE_WEB_VAPID_KEY`
# is accepted too and promoted to this name by apps/web/vite.config.ts.
VITE_FIREBASE_VAPID_KEY="replace-me"

# --- API ------------------------------------------------------------------
API_PORT=3001
API_HOST="0.0.0.0"
API_PUBLIC_URL="http://localhost:3001/api/v1"
CORS_ORIGINS=""
BODY_LIMIT_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# --- Database ---------------------------------------------------------
# The only var the app itself reads is DATABASE_URL. POSTGRES_USER/
# PASSWORD/DB below are for docker-compose.yml's postgres service (the
# official postgres image reads those directly to initialise itself) --
# keep their values in sync with the credentials embedded in DATABASE_URL,
# or docker-compose's api/web containers won't be able to connect.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mehedis_math_academy"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="mehedis_math_academy"

# --- Redis ----------------------------------------------------------------
# Whether this deployment has a Redis at all. "true" means required: the API
# refuses to start if it cannot reach one, rather than discovering it during
# somebody's checkout.
#
# "false" runs the whole product on Postgres alone. Caches always miss, the
# rate limiter counts in this process, background jobs (SMS, push, video
# metadata) run here after the response instead of in a worker, and realtime
# delivery is local -- which means exactly one API process. See
# docs/adr/0015-redis-is-optional.md before switching it off in production.
REDIS_ENABLED="true"
REDIS_URL="redis://localhost:6379"
# How long a Redis command may wait before the caller gives up and carries on
# without it. Every command on the request path -- a cache read, a rate-limit
# counter, a presence lookup -- has a working path behind it, so waiting is
# never the right answer.
REDIS_COMMAND_TIMEOUT_MS="1000"

# --- Auth (Better Auth, read by both apps/api and apps/web) -----------
BETTER_AUTH_SECRET="replace-me"
# The WEB app's public origin, not the API's -- the Better Auth HTTP
# handler is mounted in apps/web, not apps/api.
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# --- File storage ---------------------------------------------------------
# STORAGE_PROVIDER=s3 requires real AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/
# AWS_S3_BUCKET -- the API refuses to start otherwise. Switch to
# uploadthing (with a real UPLOADTHING_TOKEN) if you don't have an S3
# bucket.
STORAGE_PROVIDER="s3"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_S3_BUCKET="replace-me"
S3_PUBLIC_BASE_URL="https://replace-me.s3.ap-south-1.amazonaws.com"
UPLOADTHING_TOKEN="replace-me"

# --- Firebase (push notifications) -- all optional, feature-gated -----
# Server-side admin SDK, used to send pushes (apps/api/src/services/fcm-push-service.ts).
# Either the full service-account JSON as a single-line string:
FIREBASE_SERVICE_ACCOUNT_JSON="replace-me"
# ...or the same three fields separately, which is what a secret store that
# will not take a multi-line blob leaves you with. Escaped newlines in the key
# are restored before use.
# FIREBASE_PROJECT_ID="replace-me"
# FIREBASE_CLIENT_EMAIL="replace-me"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Public web-push client config, served to the browser via
# GET /api/v1/public/firebase-config -- these are not secrets, but still
# per-project. `FIREBASE_WEB_*` is what the Firebase console calls the same
# five values, and either spelling is read.
FIREBASE_CLIENT_API_KEY="replace-me"
FIREBASE_CLIENT_AUTH_DOMAIN="replace-me"
FIREBASE_CLIENT_PROJECT_ID="replace-me"
FIREBASE_CLIENT_MESSAGING_SENDER_ID="replace-me"
FIREBASE_CLIENT_APP_ID="replace-me"

# --- Email (SMTP) -- optional, feature-gated ---------------------------
# Read by @mma/mailer, which is what sends the password-reset link. The
# feature is off while SMTP_HOST or SMTP_FROM is "replace-me": asking for a
# reset then fails loudly rather than promising a mail nobody sent.
SMTP_HOST="replace-me"
SMTP_PORT="587"
# "true" only for implicit TLS, which is port 465. On 587 nodemailer
# negotiates STARTTLS by itself.
SMTP_SECURE="false"
# Leave both at "replace-me" for a relay that takes no credentials.
SMTP_USER="replace-me"
SMTP_PASSWORD="replace-me"
# What the recipient sees. "Mehedi's Math Academy <no-reply@mehedismathacademy.com>" or a bare address.
SMTP_FROM="replace-me"

# --- Payments (SSLCommerz) -- optional, feature-gated ------------------
SSLCOMMERZ_STORE_ID="replace-me"
SSLCOMMERZ_STORE_PASSWORD="replace-me"
SSLCOMMERZ_SANDBOX_MODE="true"

# --- SMS (OnecodeSoft) ------------------------------------------------
# Feature-gated, but two features hang off it: the admin bulk broadcast and
# signing in with a mobile number and a code. Left as "replace-me" both are
# off -- the placeholder reads as unconfigured, it is never sent as a key.
ONECODESOFT_API_KEY="replace-me"
ONECODESOFT_SENDER_ID="replace-me"

# --- Admin bootstrap (tooling/scripts/seed.ts) -------------------------
# Idempotent: creates or updates this one admin account. Safe to leave set
# and re-run.
ADMIN_EMAIL="admin@mehedismathacademy.com"
ADMIN_PASSWORD="replace-me"
