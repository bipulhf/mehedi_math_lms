APP_NAME="Mehedi's Math Academy"
APP_URL="https://mehedismathacademy.com"
NODE_ENV="production"
LOG_LEVEL="info"

# --- Web (Vite, build-time -- see apps/web/Dockerfile) ------------------
# Baked into the browser bundle when the web image is built; changing
# these requires `docker compose up --build`, not just a restart.
# Browser-facing -- must be reachable from OUTSIDE the Docker network.
VITE_API_BASE_URL="http://localhost:3001/api/v1"
# Not read from here for the docker-compose path: docker-compose.yml
# hardcodes this build arg to http://api:3001/api/v1 (the in-network
# service name) regardless of what's set below. Left for reference only.
VITE_SSR_API_BASE_URL="http://api:3001/api/v1"
VITE_FIREBASE_VAPID_KEY="replace-me"

# --- API ------------------------------------------------------------------
API_PORT=3001
API_HOST="0.0.0.0"
API_PUBLIC_URL="http://localhost:3001/api/v1"
CORS_ORIGINS=""
BODY_LIMIT_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Database ---------------------------------------------------------
# docker-compose.yml overrides DATABASE_URL to the in-network "postgres"
# host for every service regardless of what's set here -- the value below
# only matters if you run something against this .env outside Docker.
# POSTGRES_USER/PASSWORD/DB ARE read directly by the postgres service to
# initialise itself, and are also used to build that overridden URL, so
# keep them in sync if you change them.
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/mehedis_math_academy"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="mehedis_math_academy"

# --- Redis ----------------------------------------------------------------
# Which compose profiles start. "redis" starts the Redis container and the four
# workers; clearing it (COMPOSE_PROFILES=) starts neither, which is what you
# want alongside REDIS_ENABLED=false.
COMPOSE_PROFILES="redis"

# Whether this deployment has a Redis at all. "true" means required: the API
# refuses to start if it cannot reach one.
#
# "false" runs the whole product on Postgres alone -- caches always miss, the
# rate limiter counts in this process, background jobs run in the API after the
# response rather than in a worker, and realtime delivery is local, which means
# exactly one API container. Clear COMPOSE_PROFILES when you set this to false,
# or compose will start a Redis nothing talks to. See
# docs/adr/0015-redis-is-optional.md.
REDIS_ENABLED="true"

# Same story as DATABASE_URL above: docker-compose.yml overrides this to
# redis://redis:6379 for every service that reads it.
REDIS_URL="redis://redis:6379"
# How long a Redis command may wait before the caller gives up and carries on
# without it. Every command on the request path -- a cache read, a rate-limit
# counter, a presence lookup -- has a working path behind it, so waiting is
# never the right answer.
REDIS_COMMAND_TIMEOUT_MS="1000"

# --- Auth (Better Auth, read by both apps/api and apps/web) -----------
BETTER_AUTH_SECRET="replace-me"
# The WEB app's public origin (host-published port), not the API's -- the
# Better Auth HTTP handler is mounted in apps/web, not apps/api.
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# --- File storage ---------------------------------------------------------
# STORAGE_PROVIDER=s3 requires real AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/
# AWS_S3_BUCKET -- the API container refuses to start otherwise. Switch to
# uploadthing (with a real UPLOADTHING_TOKEN) if you don't have an S3
# bucket. There is no bundled self-hosted storage (e.g. MinIO) in this
# compose file -- real credentials for one of these two are required.
STORAGE_PROVIDER="s3"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_S3_BUCKET="replace-me"
S3_PUBLIC_BASE_URL="https://replace-me.s3.ap-south-1.amazonaws.com"
UPLOADTHING_TOKEN="replace-me"

# --- Firebase (push notifications) -- all optional, feature-gated -----
# Server-side admin SDK, used to send pushes (apps/api/src/services/fcm-push-service.ts).
# The full service-account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON="replace-me"
# Public web-push client config, served to the browser via
# GET /api/v1/public-config -- these are not secrets, but still per-project.
FIREBASE_CLIENT_API_KEY="replace-me"
FIREBASE_CLIENT_AUTH_DOMAIN="replace-me"
FIREBASE_CLIENT_PROJECT_ID="replace-me"
FIREBASE_CLIENT_MESSAGING_SENDER_ID="replace-me"
FIREBASE_CLIENT_APP_ID="replace-me"

# --- Email (SMTP) -- optional, feature-gated ---------------------------
# Read by @mma/mailer, which is what sends the password-reset link. The
# feature is off while SMTP_HOST or SMTP_FROM is "replace-me": asking for a
# reset then fails loudly rather than promising a mail nobody sent.
SMTP_HOST="replace-me"
SMTP_PORT="587"
# "true" only for implicit TLS, which is port 465. On 587 nodemailer
# negotiates STARTTLS by itself.
SMTP_SECURE="false"
# Leave both at "replace-me" for a relay that takes no credentials.
SMTP_USER="replace-me"
SMTP_PASSWORD="replace-me"
# What the recipient sees. "Mehedi's Math Academy <no-reply@mehedismathacademy.com>" or a bare address.
SMTP_FROM="replace-me"

# --- Payments (SSLCommerz) -- optional, feature-gated ------------------
SSLCOMMERZ_STORE_ID="replace-me"
SSLCOMMERZ_STORE_PASSWORD="replace-me"
SSLCOMMERZ_SANDBOX_MODE="true"

# --- SMS (OnecodeSoft) -- optional, feature-gated ----------------------
ONECODESOFT_API_KEY="replace-me"
ONECODESOFT_SENDER_ID="replace-me"

# --- Admin bootstrap (tooling/scripts/seed.ts, run by the `seed` service) --
# Idempotent: creates or updates this one admin account on every
# `docker compose up`. Safe to leave set and re-run.
ADMIN_EMAIL="admin@mehedismathacademy.com"
ADMIN_PASSWORD="replace-me"
