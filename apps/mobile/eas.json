{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.lms.mehedismathacademy.com",
        "EXPO_PUBLIC_WEB_ORIGIN": "https://lms.mehedismathacademy.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.lms.mehedismathacademy.com",
        "EXPO_PUBLIC_WEB_ORIGIN": "https://lms.mehedismathacademy.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.lms.mehedismathacademy.com",
        "EXPO_PUBLIC_WEB_ORIGIN": "https://lms.mehedismathacademy.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
