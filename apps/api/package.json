{
  "name": "@mma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backfill:video-metadata": "bun --env-file ../../.env src/scripts/backfill-video-metadata.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "PORT=3010 bun --env-file ../../.env --watch src/index.ts",
    "lint": "eslint .",
    "test": "bun test --env-file ../../.env src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker:audit-log-cleanup": "PORT=3010 bun --env-file ../../.env src/workers/audit-log-cleanup-worker.ts",
    "worker:file-processing": "PORT=3010 bun --env-file ../../.env src/workers/file-processing-worker.ts",
    "worker:notifications": "PORT=3010 bun --env-file ../../.env src/workers/notification-worker.ts",
    "worker:sms": "PORT=3010 bun --env-file ../../.env src/workers/sms-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@mma/auth": "workspace:*",
    "@mma/db": "workspace:*",
    "@mma/shared": "workspace:*",
    "@mma/sms": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "bullmq": "^6",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14",
    "hono": "^4.12.33",
    "ioredis": "^6",
    "isomorphic-dompurify": "^3.21.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "bun-types": "^1.3.14"
  }
}
